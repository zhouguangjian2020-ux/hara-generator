{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pt_reference_case_source.v1",
  "title": "PT reference case source",
  "type": "object",
  "required": ["schema_version", "source_policy", "source", "records", "audit_summary"],
  "properties": {
    "schema_version": {"const": "pt_reference_case_source.v1"},
    "source_policy": {"type": "object", "required": ["source_ids_are_trace_only", "runtime_matching_keys", "asil_is_recomputed"]},
    "source": {"type": "object", "required": ["file", "sheet", "row_count"]},
    "records": {"type": "array", "items": {"$ref": "#/$defs/record"}},
    "audit_summary": {"type": "object"}
  },
  "$defs": {
    "record": {
      "type": "object",
      "required": ["record_kind", "semantic_key", "normalized_failure_mode", "trace", "record_status"],
      "properties": {
        "record_kind": {"const": "pt_reference_case"},
        "semantic_key": {"type": "string", "minLength": 12},
        "canonical_function_family": {"type": ["string", "null"]},
        "semantic_role": {"type": ["string", "null"]},
        "disposition": {"enum": ["analyze", "exclude", "transfer", "needs_review"]},
        "normalized_failure_mode": {"type": "string"},
        "vehicle_hazard_id": {"type": ["string", "null"]},
        "hazard_family": {"type": ["string", "null"]},
        "scenario_id": {"type": ["string", "null"]},
        "severity": {"type": ["integer", "null"], "minimum": 0, "maximum": 3},
        "exposure": {"type": ["integer", "null"], "minimum": 1, "maximum": 4},
        "controllability": {"type": ["integer", "null"], "minimum": 0, "maximum": 3},
        "computed_asil": {"type": ["string", "null"], "enum": ["QM", "A", "B", "C", "D", null]},
        "evidence_status": {"type": "string"},
        "record_status": {"enum": ["valid_no_hazard", "needs_review", "conflict"]},
        "trace": {"type": "object", "required": ["source_file", "source_sheet", "source_row"]}
      }
    }
  }
}
